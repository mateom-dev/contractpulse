{
  "name": "@contractpulse/api",
  "version": "0.0.0",
  "private": true,
  "description": "ContractPulse registry API: workspace-scoped services, contracts and version history",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@contractpulse/cli": "workspace:*",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.20.0"
  }
}
