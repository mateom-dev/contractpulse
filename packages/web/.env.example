# Registry API (packages/api) and the workspace to show
CONTRACTPULSE_API_URL="http://127.0.0.1:3001"
CONTRACTPULSE_WORKSPACE="demo"
# Bearer token for that workspace; the seeded demo workspace accepts this one.
# Only the Next.js server reads it, it is never sent to the browser.
CONTRACTPULSE_API_TOKEN="cp_demo_local_only_change_me_0001"
